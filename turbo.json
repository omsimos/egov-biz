{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "check-types": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "format": {
      "cache": false
    },
    "format:check": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "smoke": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": []
    }
  }
}
