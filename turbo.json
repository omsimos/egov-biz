{
  "$schema": "https://turbo.build/schema.json",
  // Turborepo hides any variable a task does not declare, so a value set on the
  // Vercel project never reaches the build unless it is listed here. Wildcards
  // cover the per-service credential groups in .env.example.
  "globalEnv": [
    "NODE_ENV",
    "APP_URL",
    "REDIS_URL",
    "CHAT_MODEL",
    "AI_GATEWAY_API_KEY",
    "FILE_STORAGE_DIRECTORY",
    "TURSO_*",
    "DX_TURSO_*",
    "EGOVSSO_*",
    "EGOVPAY_*",
    "LGU_EGOVPAY_*",
    "EMESSAGE_*",
    "EVERIFY_*",
    "EGOVAI_*",
    "EGOVCHAIN_*",
    "EREPORT_*",
    "EGOVLIVENESS_*",
    "EGOVCOMPASS_*",
    "R2_*",
    "BIR_FORM_*"
  ],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    // The docs app is a Next.js static export, so its build artifacts are
    // .next/ and the exported out/ directory rather than dist/.
    "egov-docs#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "out/**"]
    },
    "check-types": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "e2e": {
      "cache": false
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "//#lint": {},
    "//#lint:fix": {
      "cache": false
    },
    "//#format": {},
    "//#format:fix": {
      "cache": false
    }
  }
}
