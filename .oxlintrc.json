{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // react/nextjs/jsx-a11y replace what eslint-config-next used to cover. Plugins
  // cannot be scoped per-glob in `overrides`, so they are enabled repo-wide; the
  // non-JSX packages simply never trigger their rules.
  "plugins": ["typescript", "unicorn", "oxc", "import", "react", "nextjs", "jsx-a11y"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "builtin": true
  },
  // drizzle/meta snapshots are regenerated by drizzle-kit. The agent-tooling
  // directories and the repo-local plugin are not application source.
  "ignorePatterns": [
    "**/drizzle/**",
    "**/.next/**",
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "tools/oxlint/local/**"
  ],
  // Rules that live in this repo, under tools/oxlint/local. Oxlint addresses
  // JS-plugin rules as `<plugin>/<rule>`, so the `local/` prefix below is the
  // namespace, not a category.
  "jsPlugins": [{ "name": "local", "specifier": "./tools/oxlint/local/index.ts" }],
  "rules": {
    "local/no-chained-type-assertions": "error",
    "local/no-conditional-empty-object-spread": "error",
    "local/no-known-value-widening": "error",
    "local/no-module-mocking": "error",
    "local/no-unknown-returns": "error",
    "local/no-unknown-type-aliases": "error",
    "local/no-unsafe-dictionary-type": "error",
    "local/no-widen-then-assert": "error",
    "local/require-safety-comment-for-type-assertion": "error",
    // Focusing the input a step just revealed (OTP, MPIN, the next question) is
    // deliberate in these single-task flows, not a page-load focus steal.
    "jsx-a11y/no-autofocus": "off",
    // The swaps it asks for do not hold here: role="dialog" sits on a motion.div
    // that a native <dialog> would stop rendering without showModal(), and
    // role="img" marks up composite progress graphics that have no src.
    "jsx-a11y/prefer-tag-over-role": "off",
    // The payment island's label sits deeper than the default depth of 2.
    "jsx-a11y/control-has-associated-label": ["error", { "depth": 5 }]
  }
}
