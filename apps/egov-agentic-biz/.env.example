# Vercel AI Gateway is used to generate the intake question tools.
# Without a key, the prototype uses the same deterministic local questions.
AI_GATEWAY_API_KEY=
CHAT_MODEL=google/gemini-2.5-flash-lite

# eGov SSO. Email, OTP, and MPIN are submitted from the browser directly to
# eGovPH. Only its one-time exchange code reaches the same-origin login route;
# exchange codes, access tokens, and the partner secret are never rendered or logged.
EGOVSSO_BASE_URL=https://hackathon-sso.e.gov.ph
EGOVSSO_PARTNER_CODE=
EGOVSSO_PARTNER_SECRET=
EGOVSSO_SESSION_TTL_SECONDS=3600

# Durable chats live in Turso (libSQL) through Drizzle.
#
# Local development: a plain file needs no token, and pending migrations are
# applied automatically on first query.
#   TURSO_DATABASE_URL=file:./data/egov-agentic-biz.sqlite
#
# For a local libSQL server instead — closer to production, since it speaks the
# same wire protocol — run `bun run db:dev` and use:
#   TURSO_DATABASE_URL=http://127.0.0.1:8080
#
# Deployed: create the database once, then read both values back out.
#   turso db create egov-agentic-biz
#   turso db show --url egov-agentic-biz
#   turso db tokens create egov-agentic-biz
# Remote databases are migrated explicitly with `bun run db:migrate`.
TURSO_DATABASE_URL=file:./data/egov-agentic-biz.sqlite
TURSO_AUTH_TOKEN=

# In-flight AI streams use Redis pub/sub so a browser can reconnect mid-answer.
# Use the TCP connection string: on Upstash that is REDIS_URL (rediss://...),
# NOT KV_REST_API_URL — the REST client cannot hold a subscription.
# Locally, `bun run infra:up` serves redis://localhost:6380.
REDIS_URL=redis://localhost:6380

# Optional overrides for the bundled BIR PDF templates.
BIR_FORM_1901_TEMPLATE_PATH=
BIR_FORM_1905_TEMPLATE_PATH=

# Generated BIR PDFs are stored in a private Cloudflare R2 bucket and served through
# the authenticated application artifact route. Include the bucket name in the URL.
R2_BASE_URL=https://<account-id>.r2.cloudflarestorage.com/<bucket>
R2_ACCESS_KEY=
R2_SECRET_KEY=

# Optional. Exa MCP works without a key on its free tier.
EXA_API_KEY=

# eGovPay hosted checkout. Keep these values server-side.
EGOVPAY_BASE_URL=https://egovpay-pgi-ws-dev.oueg.info
EGOVPAY_API_KEY=
EGOVPAY_SETTLEMENT_TEMPLATE_UUID=

# Public app origin used for eGovPay callback and return URLs.
APP_URL=

# Optional overrides. Useful when developing through a public tunnel.
EGOVPAY_CALLBACK_URL=
EGOVPAY_RETURN_URL=
