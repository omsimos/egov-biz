{
  "name": "egov-agentic-biz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env next dev",
    "build": "next build",
    "start": "next start",
    "generate:bir-form": "bun scripts/generate-bir-1901.ts --fixture",
    "generate:bir-form:complete": "bun scripts/generate-bir-1901.ts --complete-fixture",
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:generate": "bun --env-file=../../.env drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env drizzle-kit migrate",
    "db:push": "bun --env-file=../../.env drizzle-kit push",
    "db:studio": "bun --env-file=../../.env drizzle-kit studio",
    "db:dev": "turso dev --db-file ./data/egov-agentic-biz.sqlite --port 8080",
    "db:reset": "rm -rf data/egov-agentic-biz.sqlite data/egov-agentic-biz.sqlite-*",
    "db:reset:data": "bun --env-file=../../.env --env-file=.env scripts/reset-data.ts"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.15",
    "@ai-sdk/react": "^4.0.35",
    "@base-ui/react": "^1.6.0",
    "@libsql/client": "^0.17.4",
    "@phosphor-icons/react": "^2.1.10",
    "@repo/db": "workspace:*",
    "@repo/dx": "workspace:*",
    "@repo/utils": "workspace:*",
    "ai": "^7.0.32",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cuelume": "^0.1.2",
    "drizzle-orm": "0.45.2",
    "egov.js": "0.2.0",
    "ioredis": "^5.11.1",
    "motion": "^12.42.2",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resumable-stream": "^2.2.12",
    "shadcn": "^4.14.1",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "1.3.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "0.31.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14"
}
