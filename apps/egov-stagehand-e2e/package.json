{
  "name": "egov-stagehand-e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check-types": "tsc --noEmit",
    "e2e": "node --env-file-if-exists=../../.env --env-file-if-exists=.env --import tsx src/whole-business-flow.e2e.ts",
    "e2e:food": "node --env-file-if-exists=../../.env --env-file-if-exists=.env --import tsx src/whole-business-flow.e2e.ts",
    "e2e:online-retail": "node --env-file-if-exists=../../.env --env-file-if-exists=.env --import tsx src/online-retail-flow.e2e.ts",
    "e2e:self-employed": "node --env-file-if-exists=../../.env --env-file-if-exists=.env --import tsx src/self-employed-professional-flow.e2e.ts",
    "e2e:vehicle-rental": "node --env-file-if-exists=../../.env --env-file-if-exists=.env --import tsx src/vehicle-rental-flow.e2e.ts",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@browserbasehq/stagehand": "3.7.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "^4.23.1",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.0"
}
