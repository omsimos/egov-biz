# Stagehand prefers the existing Vercel AI Gateway key and falls back to OpenAI.
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
# Defaults to gateway/google/gemini-2.5-flash when AI_GATEWAY_API_KEY is set,
# otherwise openai/gpt-4.1-mini.
STAGEHAND_MODEL=

# The target app must already be running. Dev authentication is only available on loopback.
E2E_BASE_URL=http://localhost:3000
E2E_HEADLESS=true

# Required only by e2e:food, which creates three eGovPay staging transactions.
# The other scenario scripts never submit a staging payment.
E2E_ALLOW_EGOVPAY=false

# Optional stable suffix for a named run; otherwise the test generates one.
E2E_RUN_ID=
