# One demo key for both low-cost agent chat and transcript embeddings.
AI_GATEWAY_API_KEY=
CHAT_MODEL=google/gemini-2.5-flash-lite
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Local infrastructure (docker compose up -d)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=hearing-transcripts
REDIS_URL=redis://localhost:6379

# Durable app data. Relative paths are resolved from rag-hor/.
DATABASE_PATH=./data/rag-hor.sqlite

# Optional current web search provider for the agent.
# Without EXA_API_KEY, webSearch returns an actionable configuration message.
EXA_API_KEY=

# YouTube channel scraped by scripts/ingest.ts when --channel is used.
YOUTUBE_CHANNEL_URL=https://www.youtube.com/@HouseofRepresentativesPH/videos
