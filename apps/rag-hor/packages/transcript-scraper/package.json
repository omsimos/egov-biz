{
  "name": "@repo/transcript-scraper",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "format": "oxfmt src test README.md package.json tsconfig.json",
    "format:check": "oxfmt --check src test README.md package.json tsconfig.json",
    "lint": "oxlint src test",
    "test": "bun test"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
