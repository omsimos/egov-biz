{
  "name": "rag-hor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "portless run --name rag-hor next dev",
    "dev:direct": "next dev",
    "build": "bun run build:packages && next build",
    "build:packages": "bun run --cwd packages/transcript-scraper build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "ingest": "bun run build:packages && bunx tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/ingest.ts",
    "ingest:sample": "bun run ingest -- --sample 5",
    "db:reset": "rm -rf data/rag-hor.sqlite data/rag-hor.sqlite-*"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.35",
    "@qdrant/js-client-rest": "^1.18.0",
    "@repo/transcript-scraper": "workspace:*",
    "ai": "^7.0.32",
    "better-sqlite3": "^13.0.1",
    "cheerio": "^1.2.0",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.25.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resumable-stream": "^2.2.12",
    "streamdown": "^2.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "portless": "^0.13.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
