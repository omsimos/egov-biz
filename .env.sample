# Copy to .env at the repository root. Both apps read this file:
# egov-agentic-biz through `bun --env-file=../../.env`, the E2E suite through
# `--env-file-if-exists`. Every value here is server-side. None are exposed to
# the browser, and none belong in a NEXT_PUBLIC_ variable.
#
# The only values needed to boot the app are the eGov SSO pair. Everything else
# degrades to a local or deterministic fallback, described per block below.
#
# eGov partner services are reached through one gateway host,
# https://platforms-api.e.gov.ph, with a path per service.

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------

# Vercel AI Gateway generates the intake question tools and runs Exa web search,
# so this one key covers both and no separate Exa credential is needed. Without a
# key the prototype falls back to the same deterministic local questions, so the
# registration flow still runs end to end.
AI_GATEWAY_API_KEY=""
CHAT_MODEL="google/gemini-2.5-flash-lite"

# ---------------------------------------------------------------------------
# eGov SSO (required)
# ---------------------------------------------------------------------------

# Email, OTP, and MPIN go from the browser straight to eGovPH. Only the one-time
# exchange code reaches the same-origin login route. The app never renders or
# logs exchange codes, access tokens, or the partner secret.
EGOVSSO_BASE_URL="https://platforms-api.e.gov.ph/egov-sso"
EGOVSSO_PARTNER_CODE=""
EGOVSSO_PARTNER_SECRET=""
EGOVSSO_SESSION_TTL_SECONDS="604800"

# ---------------------------------------------------------------------------
# eMessage (SMS delivery)
# ---------------------------------------------------------------------------

EMESSAGE_BASE_URL="https://platforms-api.e.gov.ph/emessage"
EMESSAGE_ACCESS_TOKEN=""

# ---------------------------------------------------------------------------
# eGovPay (hosted checkout)
# ---------------------------------------------------------------------------

EGOVPAY_BASE_URL="https://platforms-api.e.gov.ph/egovpay"
EGOVPAY_API_KEY=""
EGOVPAY_SETTLEMENT_TEMPLATE_UUID=""

# Optional. Blank values reuse the three EGOVPAY_* settings above for the
# combined LGU business-permit assessment.
LGU_EGOVPAY_BASE_URL=""
LGU_EGOVPAY_API_KEY=""
LGU_EGOVPAY_SETTLEMENT_TEMPLATE_UUID=""

# Public origin eGovPay sends callbacks and returns to.
APP_URL=""

# Optional overrides, useful when developing behind a public tunnel.
EGOVPAY_CALLBACK_URL=""
EGOVPAY_RETURN_URL=""

# ---------------------------------------------------------------------------
# Databases (Turso / libSQL, through Drizzle)
# ---------------------------------------------------------------------------

# Chats and sessions. A plain file needs no token, and the first query applies
# pending migrations. To run the libSQL wire protocol locally instead, start
# `bun run db:dev` and point this at http://127.0.0.1:8080.
#
# Deployed:
#   turso db create egov-agentic-biz
#   turso db show --url egov-agentic-biz
#   turso db tokens create egov-agentic-biz
# Remote databases are migrated explicitly with `bun run db:migrate`.
TURSO_DATABASE_URL="file:./data/egov-agentic-biz.sqlite"
TURSO_AUTH_TOKEN=""

# DX owns BNRS and LGU applications, payments, and issued credentials in its own
# database, so it can never write to the app's. Blank uses the package default at
# packages/db/data/egov-dx.sqlite. Set both for a remote DX database and apply the
# packages/db migrations before deploying.
DX_TURSO_DATABASE_URL=""
DX_TURSO_AUTH_TOKEN=""

# ---------------------------------------------------------------------------
# Redis (resumable AI streams)
# ---------------------------------------------------------------------------

# In-flight streams use pub/sub so a browser can reconnect mid-answer. This must
# be the TCP connection string. On Upstash that is REDIS_URL (rediss://), never
# KV_REST_API_URL, because the REST client cannot hold a subscription.
# `bun run infra:up` serves redis://localhost:6380 locally.
REDIS_URL="redis://localhost:6380"

# ---------------------------------------------------------------------------
# Artifact storage
# ---------------------------------------------------------------------------

# Generated BIR PDFs live in a private Cloudflare R2 bucket and are served through
# the authenticated artifact route. Include the bucket name in the URL.
R2_BASE_URL="https://<account-id>.r2.cloudflarestorage.com/<bucket>"
R2_ACCESS_KEY=""
R2_SECRET_KEY=""

# With no R2 configuration, DX BIR artifacts fall back to this directory,
# relative to the app working directory. The default is data/artifacts.
FILE_STORAGE_DIRECTORY=""

# Optional overrides for the bundled BIR PDF templates.
BIR_FORM_1901_TEMPLATE_PATH=""
BIR_FORM_1905_TEMPLATE_PATH=""

# ---------------------------------------------------------------------------
# Stagehand E2E (optional, only for apps/egov-stagehand-e2e)
# ---------------------------------------------------------------------------

# Stagehand prefers AI_GATEWAY_API_KEY above and falls back to OpenAI. The model
# defaults to gateway/google/gemini-2.5-flash, or openai/gpt-4.1-mini without a
# gateway key.
OPENAI_API_KEY=""
STAGEHAND_MODEL=""

# The target app must already be running. Dev authentication only works on loopback.
E2E_BASE_URL="http://localhost:3000"
E2E_HEADLESS="true"

# Optional stable suffix for a named run. The suite generates one otherwise.
E2E_RUN_ID=""

# ---------------------------------------------------------------------------
# Other eGov partner services
# ---------------------------------------------------------------------------
#
# egov.js covers these, and no workspace in this repo reads them yet. Their
# gateway URLs are kept here so the set stays in one place. Leave them blank
# unless you are building against them.

# eVerify
EVERIFY_BASE_URL="https://platforms-api.e.gov.ph/everify"
EVERIFY_CLIENT_ID=""
EVERIFY_CLIENT_SECRET=""
EVERIFY_PUBKEY=""

# eGov AI
EGOVAI_ACCESS_CODE=""
EGOVAI_BASE_URL="https://platforms-api.e.gov.ph/egov-ai"

# eGovChain
EGOVCHAIN_BASE_URL="https://platforms-api.e.gov.ph/egovchain"
EGOVCHAIN_TOKEN=""

# eReport
EREPORT_ACCESS_CODE=""
EREPORT_ACCESS_TOKEN=""
EREPORT_BASE_URL="https://platforms-api.e.gov.ph/ereport"

# Face Liveness
EGOVLIVENESS_BASE_URL="https://platforms-api.e.gov.ph/face-liveness"
EGOVLIVENESS_API_KEY=""

# Compass
EGOVCOMPASS_API_KEY=""
EGOVCOMPASS_BASE_URL="https://platforms-api.e.gov.ph/compass"
