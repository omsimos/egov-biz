{
  "name": "egov-biz-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/db",
    "packages/dx",
    "packages/transcript-scraper",
    "packages/utils"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "clean": "rm -rf node_modules .turbo apps/*/.next apps/*/out apps/*/src/.source apps/*/dist apps/*/node_modules apps/*/.turbo packages/*/.next packages/*/dist packages/*/node_modules packages/*/.turbo",
    "debug:business": "bun run dev:business 2>&1 | tee \"/tmp/ebiz\"",
    "dev:business": "turbo run dev --filter=egov-biz",
    "dev:docs": "turbo run dev --filter=egov-docs",
    "demo:reset-businesses": "bun --filter egov-biz demo:reset-businesses",
    "e2e:business": "turbo run e2e --filter=egov-stagehand-e2e",
    "format": "oxfmt --check",
    "format:fix": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.80.0",
    "egov.js": "0.2.0",
    "lefthook": "2.1.10",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "turbo": "2.10.11"
  },
  "packageManager": "bun@1.4.0"
}
