{
  "name": "hackathon-idea-fact-checker",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/db",
    "packages/dx",
    "packages/transcript-scraper",
    "packages/utils"
  ],
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "clean": "rm -rf node_modules .turbo apps/*/.next apps/*/dist apps/*/node_modules apps/*/.turbo packages/*/.next packages/*/dist packages/*/node_modules packages/*/.turbo",
    "debug:business": "bun run dev:business 2>&1 | tee \"/tmp/ebiz\"",
    "dev:business": "turbo run dev --filter=egov-agentic-biz",
    "demo:reset-businesses": "bun --filter egov-agentic-biz run demo:reset-businesses",
    "e2e:business": "turbo run e2e --filter=egov-stagehand-e2e",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "lint": "turbo run lint",
    "test": "turbo run test"
  },
  "devDependencies": {
    "egov.js": "file:../egov.js",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "turbo": "2.10.5"
  },
  "packageManager": "bun@1.3.14"
}
