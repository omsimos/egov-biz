{
  "name": "hackathon-idea-fact-checker",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:sso": "turbo run dev --filter=@repo/egov-sso-sample",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "lint": "turbo run lint",
    "smoke:egov": "turbo run smoke --filter=@repo/egov-smoke",
    "test": "turbo run test"
  },
  "devDependencies": {
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "turbo": "2.10.5"
  }
}
