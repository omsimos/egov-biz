{
  "name": "@repo/egov",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "import": "./dist/env.js"
    },
    "./egov-sso": {
      "types": "./dist/services/egov-sso.d.ts",
      "import": "./dist/services/egov-sso.js"
    },
    "./everify": {
      "types": "./dist/services/everify.d.ts",
      "import": "./dist/services/everify.js"
    },
    "./emessage": {
      "types": "./dist/services/emessage.d.ts",
      "import": "./dist/services/emessage.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "format": "oxfmt src test package.json tsconfig.json",
    "format:check": "oxfmt --check src test package.json tsconfig.json",
    "lint": "oxlint src test",
    "test": "bun test"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
